# Copy to `.env` and fill in the values. `.env` is gitignored; this file is not.
#
# Clerk publishable key for this Expo app
# This key is public by design and is inlined into the client bundle -- it is NOT a secret.
# The matching CLERK_SECRET_KEY belongs ONLY in server/.env, never here: any EXPO_PUBLIC_*
# variable ships to every device that runs the app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Base URL of the Express API in server/.
# A physical device cannot reach `localhost` -- that resolves to the phone itself.
# Android emulator: http://10.0.2.2:3000   iOS simulator: http://localhost:3000
EXPO_PUBLIC_API_URL=http://10.28.68.234:3000

# --- Sign in with Google -------------------------------------------------------
# Native Google sign-in (the OS account picker, not a browser). All of these are
# public client identifiers, not secrets -- the Client *Secret* from Google Cloud
# goes in the Clerk Dashboard only, never in this repo.
#
# `app.config.ts` copies these into `expo.extra` at build time. That copy is what
# makes them work in a release build: Expo does not inline EXPO_PUBLIC_* into
# node_modules, so the `process.env` read inside @clerk/expo sees nothing in an
# APK/IPA and reads `extra` instead.
#
# EAS Build does not upload this file (it is gitignored), so for a cloud build set
# the same values as EAS environment variables -- see docs/GOOGLE_SIGN_IN.md.

# Required on both platforms. The *web* client ID, even for a native build: it is
# the audience Clerk verifies Google's ID token against.
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=

# Android. Created against the package name plus the signing certificate's SHA-1,
# so a debug build and an EAS-signed release build need different ones unless the
# same keystore signs both. Not read by the SDK -- the credential picker resolves
# the app by package name and certificate -- but keep it here so the value has a home.
EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID=

# iOS only, and required there: the hook refuses to start without it.
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=

# iOS only, optional. With it the OS credential sheet handles the flow; without it
# iOS falls back to a browser sheet. It is the iOS client ID reversed: everything
# before ".apps.googleusercontent.com", prefixed with "com.googleusercontent.apps.".
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=
