generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  moduleFormat           = "esm"
  runtime                = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Join key to Clerk. The schema was Clerk-native from the start.
  clerkUserId   String         @unique @map("clerk_user_id")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  profile       AgentProfile?
  conversations Conversation[]

  @@map("users")
}

model AgentProfile {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String         @unique @map("user_id") @db.Uuid
  displayName        String         @default("Mirai") @map("display_name")
  tone               AgentTone      @default(neutral)
  verbosity          AgentVerbosity @default(balanced)
  customInstructions String         @default("") @map("custom_instructions")
  updatedAt          DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("agent_profiles")
}

model Conversation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String?
  /// Pinned to the top of the chat list. A real column, unlike `archived`, which the
  /// client keeps to itself: a pin is a deliberate statement about which few chats
  /// matter, and one that disappeared on another device would be worse than none.
  pinned    Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages  Message[]

  @@index([userId, updatedAt(sort: Desc)], map: "conversations_updated_at_idx")
  @@index([userId, pinned(sort: Desc), updatedAt(sort: Desc)], map: "conversations_pinned_updated_at_idx")
  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String        @default("")
  status         MessageStatus @default(complete)
  model          String?
  inputTokens    Int?          @map("input_tokens")
  outputTokens   Int?          @map("output_tokens")
  /// Web sources consulted for this reply. Null on a reply generated before search
  /// existed, which is a different thing from an empty list (searched, found nothing).
  sources        Json?
  /// Photos and files the user attached to this turn, as the upload pipeline left them
  /// (server/src/attachments.ts). URLs and extracted text only -- never the file. Null
  /// on a turn sent before attachments existed.
  attachments    Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversationId])
  @@index([conversationId, createdAt], map: "messages_created_at_idx")
  @@map("messages")
}

/// Pre-existing hand-rolled migration ledger. Left as-is; Prisma Migrate is not
/// driving this database.
model Migration {
  name      String   @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("migrations")
}

enum AgentTone {
  neutral
  warm
  direct
  playful

  @@map("agent_tone")
}

enum AgentVerbosity {
  concise
  balanced
  thorough

  @@map("agent_verbosity")
}

enum MessageRole {
  user
  assistant
  system

  @@map("message_role")
}

enum MessageStatus {
  complete
  incomplete
  failed

  @@map("message_status")
}
