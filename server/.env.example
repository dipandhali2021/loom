# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Neon Postgres -----------------------------------------------------------
# Pooled endpoint (PgBouncer, host contains "-pooler"). Used by the running server.
DATABASE_URL=""
# Direct endpoint (no "-pooler"). Used ONLY by the Prisma CLI: introspection and
# migrations must not go through a transaction pooler. See prisma.config.ts.
DIRECT_URL=""
# Generate both with:
#   neon connection-string main --project-id <id> --database-name <db> \
#     --role-name <role> --org-id <org> --pooled true|false
# Prefer sslmode=verify-full: pg v9 will downgrade the meaning of sslmode=require.

# --- Clerk -------------------------------------------------------------------
# Dashboard -> API keys. The publishable key is safe to expose; the secret key is not.
CLERK_PUBLISHABLE_KEY=""
# Server-only. Never copy this into the Expo app or any EXPO_PUBLIC_* variable.
CLERK_SECRET_KEY=""
# Optional, comma-separated. Restricts which frontend origins may have minted the
# session tokens this API accepts. Leave empty to accept any of the app's frontends.
CLERK_AUTHORIZED_PARTIES=""

# --- Server ------------------------------------------------------------------
PORT="3000"
# "*" for local development, or a comma-separated origin list in production.
CORS_ORIGIN="*"



# --- AI (OpenAI-compatible) --------------------------------------------------
# Any endpoint that speaks POST /chat/completions. The base URL includes /v1.
AI_BASE_URL="https://ninerouter-latest-u3o4.onrender.com/v1"
# Server-only, exactly like CLERK_SECRET_KEY: the app never talks to this endpoint
# directly, it calls /api/v1/conversations/:id/completions and this server proxies.
AI_API_KEY=""
# Model ids the three in-app tiers resolve to. Get the list for your endpoint with:
#   curl -H "Authorization: Bearer $AI_API_KEY" "$AI_BASE_URL/models"
AI_MODEL_FAST="ag/gemini-3.7-flash-low"
AI_MODEL_BALANCED="ag/gemini-3.7-flash-medium"
AI_MODEL_SMART="ag/claude-sonnet-4-6"

# --- Code execution (Deno Sandbox) -------------------------------------------
# All optional. With no token the Run button reports the runner unavailable and
# nothing else about the server changes.
#
# Get a token at console.deno.com -> Settings -> Organization tokens.
# An organization token starts with `ddo_` and needs no DENO_DEPLOY_ORG; a personal
# token starts with `ddp_` and does. Server-only, like every secret in this file.
DENO_DEPLOY_TOKEN=""
DENO_DEPLOY_ORG=""

# Sandboxes, volumes and snapshots must all live in one region: "ord" or "ams".
SANDBOX_REGION="ord"

# The toolchain snapshot -- gcc, g++, python3, a JDK -- built once with:
#   npm run sandbox:provision
# It prints the slug to paste here. Left empty, runs boot the stock image, which
# has Deno but none of the other three.
SANDBOX_SNAPSHOT=""

# Wall clock for one run, compile included.
SANDBOX_TIMEOUT_MS="20000"
# RAM per sandbox. The platform accepts 768MiB-4096MiB.
SANDBOX_MEMORY="1280MiB"
# Sandboxes held open at once. Deno Deploy allows 5 per organization during the
# pre-release and refuses the 6th rather than queueing it, so leave headroom.
SANDBOX_CONCURRENCY="3"

# "true" mounts a per-user volume at /workspace, so files one run writes are still
# there for the next. "false" runs entirely on the sandbox's ephemeral disk.
SANDBOX_PERSIST="true"
# Size of that per-user volume. The docs say 300MB is the floor; in practice a create
# at 300MB fails and 400MB is the smallest that works.
SANDBOX_VOLUME_CAPACITY="400MB"
